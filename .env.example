# Copy to .env.local for development. In production, set these in your host's
# environment settings — never commit real values.

# ── Public (inlined into the browser bundle at build time) ───────────────────
# Canonical origin used for canonical URLs, sitemap, Open Graph, and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://idphoto.us

# ── Server only ───────────────────────────────────────────────────────────────
# MongoDB connection string. Optional: without it the site works, and the
# contact/feedback/photo-editor endpoints return 503.
MONGODB_URI=
MONGODB_DB=idphoto
# Random secret (16+ chars) for hashing client IPs. Required in production when
# MONGODB_URI is set. Generate one with: openssl rand -hex 32
IP_HASH_SALT=
# Optional Slack-compatible webhook notified when a contact message arrives.
CONTACT_WEBHOOK_URL=
# debug | info | warn | error
LOG_LEVEL=info

# ── Photo processing (PixPassport API) ────────────────────────────────────────
# Used by the photo editor widget. Without the key, /api/photo/process returns 503.
PASSPORT_API_URL=https://api.pixpassport.com
PASSPORT_API_KEY=

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# One mailer for the whole site (src/lib/mail). Without SMTP_HOST, email
# features return 503 and contact notifications are skipped.
# Gmail: smtp.gmail.com, port 587, SMTP_SECURE=false, and an app password.
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS); false for 587 (STARTTLS).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender shown to recipients. Gmail only allows the account or its aliases.
# Defaults to SMTP_USER.
MAIL_FROM=
# Inbox that receives contact-form notifications. Optional.
MAIL_TO=

# ── Payments (Razorpay) ───────────────────────────────────────────────────────
# Photo downloads are paid (src/lib/payments). Without the key id and secret,
# /api/payments/create-order returns 503. Use rzp_test_ keys in development.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret of the webhook at https://idphoto.us/api/webhooks/razorpay
# (Dashboard → Settings → Webhooks; events payment.captured and payment.failed).
RAZORPAY_WEBHOOK_SECRET=
# Fallback currency when the visitor's country has no dedicated price (USD, GBP, EUR, INR).
NEXT_PUBLIC_PAYMENT_CURRENCY=USD
# Optional: override the base-currency prices (major units), e.g. 1 for test payments.
NEXT_PUBLIC_PAYMENT_AMOUNT=
NEXT_PUBLIC_EXPERT_EDIT_AMOUNT=
# Currencies enabled on the Razorpay account, comma-separated. Defaults to all.
PAYMENT_ENABLED_CURRENCIES=
# false = always charge NEXT_PUBLIC_PAYMENT_CURRENCY, ignoring the visitor's country.
GEO_PRICING_ENABLED=true
# Development only: pretend requests come from this country (e.g. GB, IN).
GEO_COUNTRY_OVERRIDE=

# ── Cloudinary ────────────────────────────────────────────────────────────────
# Optional. When set, each processed photo is copied to this account (what paid
# orders download and email) and invoice PDFs are stored there.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
