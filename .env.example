# Copy to .env.local for development. In production, set these in your host's
# environment settings — never commit real values.

# ── Public (inlined into the browser bundle at build time) ───────────────────
# Canonical origin used for canonical URLs, sitemap, Open Graph, and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://idphoto.us
# Only "production" allows indexing. Anything else (or unset) => noindex +
# disallow-all robots.txt, so preview/staging deployments stay out of search.
NEXT_PUBLIC_SITE_ENV=development

# ── Server only ───────────────────────────────────────────────────────────────
# MongoDB connection string. Optional: without it the site works, and the
# contact/feedback endpoints return 503.
MONGODB_URI=
MONGODB_DB=idphoto
# Random secret (16+ chars) for hashing client IPs. Required in production when
# MONGODB_URI is set. Generate one with: openssl rand -hex 32
IP_HASH_SALT=
# Optional Slack-compatible webhook notified when a contact message arrives.
CONTACT_WEBHOOK_URL=
# debug | info | warn | error
LOG_LEVEL=info
